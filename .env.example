BIND_HOST=127.0.0.1
PORT=8000
# Fallback until an administrator saves an Ollama URL in the UI.
OLLAMA_BASE_URL=http://192.168.1.76:11434
OLLAMA_MODEL=qwen3-server:latest
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_TOKENS=512
# Set to 1 when the application is served over HTTPS.
SESSION_COOKIE_SECURE=0
REDIS_URL=redis://127.0.0.1:6380/0
BALANCE_QUEUE=balance
RUN_TIMEOUT_SECONDS=600
RUN_MEMORY_MB=4096
# Default metadata store is var/app.sqlite3.
# DATABASE_URL=postgresql+psycopg://balance:balance@localhost:5432/balance
