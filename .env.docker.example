# HTTP access. Set 0.0.0.0 to make the service available from other machines.
BALANCE_HTTP_BIND=127.0.0.1
BALANCE_HTTP_PORT=8080

# Existing Ollama server in the LAN. These are defaults until saved in Administration.
OLLAMA_BASE_URL=http://192.168.1.76:11434
OLLAMA_MODEL=qwen3-server:latest
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_TOKENS=512

# Use 1 only behind an HTTPS endpoint.
SESSION_COOKIE_SECURE=0

# Reduce both worker counts to 1 on a small machine.
BALANCE_WORKER_CONCURRENCY=2
BALANCE_NORMALIZATION_WORKERS=2
RUN_TIMEOUT_SECONDS=3600
RUN_MEMORY_MB=4096
